void zone(int zone) {
  if (zone == 1) {
    FR(200, 0.03, 0.12, 20, 'u');
    yt(150);
    R2(50, 'n');
    FC(50, 0.004, 0.12, 0, 'n');
    down();
    yt(200);
    GTF(90);
    GTF(-90);
    GF(150, 250);
    O2();
    yt(100);
    up();
    GB(150, 250);
    GTB(90);
    GTB(-90);
    BL(100, 0.01, 0.1, 170);
    R2(50, 'o');
  } else if (zone == 2) {
    FR(200, 0.01, 0.05, 20, 'u');
    yt(150);
    R2(50, 'n');
    FC(50, 0.001, 0.01, 0, 'n');
    down();
    yt(200);
    GTF(-90);
    GTF(90);
    GF(150, 600);
    GTF(90);
    GF(150, 250);
    O2();
    yt(100);
    up();
    GB(150, 250);
    GTB(90);
    GB(150, 600);
    GTB(90);
    GTB(-90);
    BL(100, 0.01, 0.1, 170);
    R2(50, 'o');
  } else if (zone == 3) {
    FR(200, 0.03, 0.12, 20, 'u');
    yt(150);
    R2(50, 'n');
    FC(50, 0.004, 0.07, 0, 'n');
    down();
    yt(200);
    GTF(-90);
    GTF(90);
    GF(150, 600);
    GTF(90);
    GF(150, 250);
    GTF(-90);
    O2();
    yt(100);
    up();
    GTB(-90);
    GB(150, 250);
    GTB(90);
    GB(150, 600);
    GTB(90);
    GTB(-90);
    BL(100, 0.005, 0.05, 170);
    R2(50, 'o');
  }
}

void c() {  //out wind
  FT(200, 0.03, 0.12, 1500, 'n');
  FC(50, 0.005, 0.08, 0, 'u');
  yt(200);
  GTF(-80);
  GTF(80);
  GF(150, 1000);
  GTF(90);
  GF(150, 240);
  GTF(80);
  down();
  yt(150);
  O2();
  yt(150);
  up();
  yt(150);
  GF(70, 300);
  GB(70, 300);
  GTB(80);
  GB(150, 240);
  GTB(90);
  GB(150, 1000);
  GTB(70);
  GTB(-70);
  BT(200, 0.03, 0.12, 1000);
  BL(200, 0.03, 0.12, 0);
}

